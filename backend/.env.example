# Neon PostgreSQL pooled connection string (recommended for Vercel/serverless)
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-NEON-POOLER-HOST/DATABASE?sslmode=require

# Optional PostgreSQL pool size. Keep modest for serverless deployments.
DB_POOL_MAX=10

JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=8h
PORT=5000
